# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, NEVER expose to client

# Homologação: usadas SOMENTE no preview do Vercel (VERCEL_ENV=preview). Cadastrar só no escopo Preview.
# Produção e ambiente local ignoram estas. Preview sem as três do Supabase não faz build (não cai para as de cima).
NEXT_PUBLIC_STAGING_SUPABASE_URL=""
NEXT_PUBLIC_STAGING_SUPABASE_ANON_KEY=""
STAGING_SUPABASE_SERVICE_ROLE_KEY=""                 # server-only
# Opcionais (as duas ou nenhuma): sem elas o WhatsApp fica desligado no preview. O preview nunca lê WA_SERVICE_*.
STAGING_WA_SERVICE_URL=""
STAGING_WA_SERVICE_TOKEN=""                          # server-only

# ─── Database (Prisma) ──────────────────────────────────────
# Pooled connection (pgBouncer) for the app:
DATABASE_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations:
DIRECT_URL="postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_DOMAIN="barber.app"          # base domain for tenant subdomains
NEXT_PUBLIC_MASTER_HOST="admin.barber.app"   # platform (master) host

# ─── Stripe (M3) ────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Notifications ──────────────────────────────────────────
RESEND_API_KEY=""                                  # chave do Resend (envio de e-mail dos alertas)
NOTIFICATIONS_FROM="Barbearia Oliveira 01 <no-reply@seu-dominio.com>"  # remetente verificado no Resend

# WhatsApp — gateway próprio (Baileys) em wa-gateway/ (deploy no Render).
# Cada barbearia conecta o próprio número via QR em Admin → Configurações.
WA_SERVICE_URL=""         # URL pública do gateway (ex.: https://wa-gateway.onrender.com); local: http://localhost:8080
WA_SERVICE_TOKEN=""       # segredo compartilhado (header x-wa-token) — igual no app e no gateway

# ─── Leads da landing (/distribuidoras) ─────────────────────
LEAD_IP_SALT=""           # server-only; sal do hash de IP do anti-spam (16+ caracteres aleatórios). Sem ele o formulário não grava.
RATE_LIMIT_IP_SALT=""     # server-only; sal do hash de IP do limite de tentativas do totem (32+ caracteres aleatórios, diferente do LEAD_IP_SALT). Sem ele o limite por IP é pulado (os tetos por barbearia continuam) e o servidor registra o alerta.
